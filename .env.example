# Copy to .env and fill in your Fulfillment session token.
#
# How to get the token (one-time setup):
# 1. Open https://fulfillment.wolt.com and log in via SSO
# 2. Open DevTools → Network
# 3. Click any request to fulfillment.wolt.com (e.g. offers-summary/search)
# 4. Copy the Bearer token from the Authorization header (without the "Bearer " prefix)
#
FULFILLMENT_BEARER_TOKEN=

# Looker API (vendor reports) — run: python3 setup_looker_auth.py
# Create API3 keys in Looker: Admin → Users → your user → Edit → API3 Keys
LOOKERSDK_BASE_URL=https://looker.wolt.com
LOOKERSDK_CLIENT_ID=
LOOKERSDK_CLIENT_SECRET=
LOOKERSDK_VERIFY_SSL=true

# SMTP (vendor report email delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Default recipient for send_vendor_report.py (comma-separated for multiple)
VENDOR_REPORT_RECIPIENT=sh.bayramov@safetrade.az

# Shrink performance report (send_shrink_report.py) — runs every Monday
# Looker explore slug for item-level 3-month shrinkage % (Share → Get link → /x/<slug>)
SHRINK_REPORT_QUERY_SLUG=
# Category team recipients (comma-separated)
SHRINK_REPORT_RECIPIENT=wolt-market-aze-category@wolt.com
# Excel column names (match Looker export labels)
SHRINK_REPORT_SHRINKAGE_COLUMN=Shrinkage % (3M)
SHRINK_REPORT_CATEGORY_COLUMN=Primary category
# Top N best performers after herbs exclusion (0 = all)
SHRINK_REPORT_TOP_N=100

# Gmail draft automation signature
ON_BEHALF_NAME=Nurlan Rasulov
ON_BEHALF_EMAIL=nurlan.rasulov@wolt.com

# Only auto-send drafts whose subject contains this (case-insensitive)
DRAFT_SUBJECT_CONTAINS=VSL REPORT

# GitHub Actions (cloud) — run: python3 setup_github_secrets.py --upload
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
