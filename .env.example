# Copy to .env and fill in your Fulfillment session token.
#
# How to get the token (one-time setup):
# 1. Open https://fulfillment.wolt.com and log in via SSO
# 2. Open DevTools → Network
# 3. Click any request to fulfillment.wolt.com (e.g. offers-summary/search)
# 4. Copy the Bearer token from the Authorization header (without the "Bearer " prefix)
#
FULFILLMENT_BEARER_TOKEN=

# Shrink contributor report (send_shrink_report.py) — runs every Monday
# Data source: snowflake (default) or looker
SHRINK_DATA_SOURCE=snowflake

# Snowflake (primary data source)
SNOWFLAKE_ACCOUNT=doordash
SNOWFLAKE_USER=nurlan.rasulov@wolt.com
SNOWFLAKE_PASSWORD=
SNOWFLAKE_AUTHENTICATOR=PROGRAMMATIC_ACCESS_TOKEN
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
# Override table names if defaults differ in your warehouse
SNOWFLAKE_METRICS_TABLE=WOLT_MARKET.RETAIL_PLATFORMS.RETAIL_PLATFORM_INVENTORY_WAREHOUSE_PRODUCT_REPORTING_WM
SNOWFLAKE_ITEMS_TABLE=WOLT_MARKET.INTERMEDIATE.F_RETAIL_PLATFORM_INVENTORY_AGGREGATED_EVENTS_WM
# Optional alias used by snowflake_query.py
# SNOWFLAKE_PRODUCTS_TABLE=WOLT_MARKET.INTERMEDIATE.F_RETAIL_PLATFORM_INVENTORY_AGGREGATED_EVENTS_WM
SNOWFLAKE_DATABASE=WOLT_MARKET
# Prefer browser SSO when PAT is blocked by network policy:
# SNOWFLAKE_AUTHENTICATOR=externalbrowser
# Or provide a full custom SQL query (overrides table defaults)
# SHRINK_SNOWFLAKE_SQL=

# Looker (optional fallback for vendor reports and shrink) — run: python3 setup_looker_auth.py
LOOKERSDK_BASE_URL=https://looker.wolt.com
LOOKERSDK_CLIENT_ID=
LOOKERSDK_CLIENT_SECRET=
LOOKERSDK_VERIFY_SSL=true
SHRINK_REPORT_QUERY_SLUG=

# Category team recipients (comma-separated)
SHRINK_REPORT_RECIPIENT=wolt-market-aze-category@wolt.com
# Excel column names (match export labels)
SHRINK_REPORT_CONTRIBUTOR_COLUMN=Shrink value
SHRINK_REPORT_CATEGORY_COLUMN=Primary category
SHRINK_REPORT_GTIN_COLUMN=Gtin
SHRINK_REPORT_SOLD_UNITS_COLUMN=Units sold
# Top N biggest shrink contributors after Herbs and FnV exclusion
SHRINK_REPORT_TOP_N=10

# SMTP (email delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Default recipient for send_vendor_report.py (comma-separated for multiple)
VENDOR_REPORT_RECIPIENT=sh.bayramov@safetrade.az

# Gmail draft automation signature
ON_BEHALF_NAME=Nurlan Rasulov
ON_BEHALF_EMAIL=nurlan.rasulov@wolt.com

# Only auto-send drafts whose subject contains this (case-insensitive)
DRAFT_SUBJECT_CONTAINS=VSL REPORT

# GitHub Actions (cloud) — run: python3 setup_github_secrets.py --upload
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
